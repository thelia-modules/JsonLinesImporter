{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:thelia:json-lines-importer:product-import:1.0",
  "title": "Product object of a line of a Thelia JSON Lines import",
  "description": "One line of the file is one product object. Prices exclude taxes. Collections: an array replaces the whole collection, null empties it, an absent key leaves it unchanged.",
  "type": "object",
  "required": ["ref"],
  "additionalProperties": false,
  "properties": {
    "ref": { "$ref": "#/$defs/reference", "description": "product.ref, identity key (created or updated)." },
    "visible": { "type": "boolean", "default": false },
    "virtual": { "type": "boolean", "default": false },
    "position": { "type": ["integer", "null"], "default": 0 },

    "title": { "$ref": "#/$defs/nullableString" },
    "chapo": { "$ref": "#/$defs/nullableString" },
    "description": { "$ref": "#/$defs/nullableString", "description": "HTML accepted." },
    "postscriptum": { "$ref": "#/$defs/nullableString" },
    "meta_title": { "$ref": "#/$defs/nullableString" },
    "meta_description": { "$ref": "#/$defs/nullableString" },
    "meta_keywords": { "$ref": "#/$defs/nullableString" },
    "url": { "$ref": "#/$defs/nullableString", "description": "Former address of the product page, written to rewriting_url as a 301 redirection." },
    "i18n": {
      "$ref": "#/$defs/i18nBlock",
      "description": "Translatable content by locale; wins over the same keys at the root.",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z]{2}_[A-Z]{2}$": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": { "$ref": "#/$defs/nullableString" },
            "chapo": { "$ref": "#/$defs/nullableString" },
            "description": { "$ref": "#/$defs/nullableString" },
            "postscriptum": { "$ref": "#/$defs/nullableString" },
            "meta_title": { "$ref": "#/$defs/nullableString" },
            "meta_description": { "$ref": "#/$defs/nullableString" },
            "meta_keywords": { "$ref": "#/$defs/nullableString" },
            "url": { "$ref": "#/$defs/nullableString" }
          }
        }
      }
    },

    "ean_code": { "$ref": "#/$defs/nullableString" },
    "quantity": { "type": "number", "default": 0 },
    "weight": { "type": "number", "minimum": 0, "default": 0 },
    "newness": { "type": "boolean", "default": false },
    "promo": { "type": "boolean", "default": false },
    "price": { "$ref": "#/$defs/amount" },
    "promo_price": { "$ref": "#/$defs/amount" },
    "prices": { "$ref": "#/$defs/prices" },

    "tax_rule": {
      "type": ["object", "null"],
      "description": "Absent: the default tax rule of the shop.",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "$ref": "#/$defs/label" },
        "rate": { "type": "number", "minimum": 0 }
      }
    },

    "categories": {
      "type": ["array", "null"],
      "description": "Without default:true, the first category is the default category.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title"],
        "properties": {
          "title": { "$ref": "#/$defs/label" },
          "default": { "type": "boolean" }
        }
      },
      "not": { "$ref": "#/$defs/severalDefaults" }
    },

    "brand": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "$ref": "#/$defs/label" }
      }
    },

    "features": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["feature", "value"],
        "properties": {
          "feature": {
            "type": "object",
            "additionalProperties": false,
            "anyOf": [{ "required": ["title"] }, { "required": ["i18n"] }],
            "properties": {
              "title": { "$ref": "#/$defs/label" },
              "i18n": { "$ref": "#/$defs/titleI18n" }
            }
          },
          "value": {
            "type": "object",
            "additionalProperties": false,
            "anyOf": [{ "required": ["title"] }, { "required": ["i18n"] }],
            "properties": {
              "title": { "$ref": "#/$defs/label" },
              "i18n": { "$ref": "#/$defs/titleI18n" },
              "free": { "type": "boolean", "default": false }
            }
          }
        }
      }
    },

    "variants": {
      "type": ["array", "null"],
      "items": { "$ref": "#/$defs/variant" },
      "not": { "$ref": "#/$defs/severalDefaults" }
    },

    "images": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source"],
        "properties": {
          "_key": { "type": "string", "minLength": 1, "description": "Technical key, referenced by variants[].images." },
          "source": { "$ref": "#/$defs/source" },
          "visible": { "type": "boolean", "default": true },
          "position": { "type": ["integer", "null"] },
          "title": { "$ref": "#/$defs/nullableString" },
          "chapo": { "$ref": "#/$defs/nullableString" },
          "description": { "$ref": "#/$defs/nullableString" },
          "postscriptum": { "$ref": "#/$defs/nullableString" },
          "i18n": { "$ref": "#/$defs/mediaI18n" }
        }
      }
    },

    "documents": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source"],
        "properties": {
          "source": { "$ref": "#/$defs/source" },
          "visible": { "type": "boolean", "default": true },
          "position": { "type": ["integer", "null"] },
          "title": { "$ref": "#/$defs/nullableString" },
          "chapo": { "$ref": "#/$defs/nullableString" },
          "description": { "$ref": "#/$defs/nullableString" },
          "postscriptum": { "$ref": "#/$defs/nullableString" },
          "i18n": { "$ref": "#/$defs/mediaI18n" }
        }
      }
    },

    "videos": {
      "type": ["array", "null"],
      "description": "Videos of the product (ProductVideo model of the core): a YouTube, Vimeo or Dailymotion address, or a video file (mp4, webm, ogv) by URL or path on the server. Placed after the images of the product.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source"],
        "properties": {
          "source": { "$ref": "#/$defs/source" },
          "visible": { "type": "boolean", "default": true },
          "position": { "type": ["integer", "null"], "description": "Order of the videos among themselves." },
          "title": { "$ref": "#/$defs/nullableString" },
          "alt": { "$ref": "#/$defs/nullableString", "description": "Accessible name of the player." },
          "chapo": { "$ref": "#/$defs/nullableString" },
          "description": { "$ref": "#/$defs/nullableString" },
          "postscriptum": { "$ref": "#/$defs/nullableString" },
          "group": { "$ref": "#/$defs/nullableString", "deprecated": true, "description": "Deprecated, ignored (former Thelia Blocks destination)." },
          "i18n": {
            "$ref": "#/$defs/i18nBlock",
            "additionalProperties": false,
            "patternProperties": {
              "^[a-z]{2}_[A-Z]{2}$": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "title": { "$ref": "#/$defs/nullableString" },
                  "alt": { "$ref": "#/$defs/nullableString" },
                  "chapo": { "$ref": "#/$defs/nullableString" },
                  "description": { "$ref": "#/$defs/nullableString" },
                  "postscriptum": { "$ref": "#/$defs/nullableString" },
                  "group": { "$ref": "#/$defs/nullableString", "deprecated": true }
                }
              }
            }
          }
        }
      }
    },

    "accessories": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref"],
        "properties": {
          "ref": { "$ref": "#/$defs/reference" },
          "position": { "type": ["integer", "null"] }
        }
      }
    }
  },

  "$defs": {
    "reference": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "label": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "nullableString": { "type": ["string", "null"] },
    "source": { "type": "string", "minLength": 1, "description": "URL or path of the file." },
    "amount": { "type": "number", "minimum": 0, "description": "Amount excluding taxes." },

    "i18nBlock": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z]{2}_[A-Z]{2}$" }
    },

    "titleI18n": {
      "$ref": "#/$defs/i18nBlock",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z]{2}_[A-Z]{2}$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title"],
          "properties": { "title": { "$ref": "#/$defs/label" } }
        }
      }
    },

    "mediaI18n": {
      "$ref": "#/$defs/i18nBlock",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z]{2}_[A-Z]{2}$": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": { "$ref": "#/$defs/nullableString" },
            "chapo": { "$ref": "#/$defs/nullableString" },
            "description": { "$ref": "#/$defs/nullableString" },
            "postscriptum": { "$ref": "#/$defs/nullableString" }
          }
        }
      }
    },

    "severalDefaults": {
      "type": "array",
      "contains": { "type": "object", "required": ["default"], "properties": { "default": { "const": true } } },
      "minContains": 2
    },

    "prices": {
      "type": ["array", "null"],
      "description": "Prices by currency. from_default_currency defaults to true, and to false when price is present (price wins). Without price, promo_price is ignored.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["currency"],
        "if": { "required": ["from_default_currency"], "properties": { "from_default_currency": { "const": false } } },
        "then": { "required": ["price"] },
        "properties": {
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$", "description": "ISO 4217 code existing in currency.code." },
          "price": { "$ref": "#/$defs/amount" },
          "promo_price": { "$ref": "#/$defs/amount" },
          "from_default_currency": { "type": "boolean", "default": true }
        }
      }
    },

    "attributeLabel": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [{ "required": ["title"] }, { "required": ["i18n"] }],
      "properties": {
        "title": { "$ref": "#/$defs/label" },
        "i18n": { "$ref": "#/$defs/titleI18n" }
      }
    },

    "variant": {
      "type": "object",
      "description": "Sale element. Its absent fields take the values of the root of the product.",
      "additionalProperties": false,
      "properties": {
        "ref": { "$ref": "#/$defs/reference" },
        "ean_code": { "$ref": "#/$defs/nullableString" },
        "default": { "type": "boolean", "default": false },
        "visible": { "type": "boolean", "default": true },
        "quantity": { "type": "number", "default": 0 },
        "weight": { "type": "number", "minimum": 0, "default": 0 },
        "newness": { "type": "boolean", "default": false },
        "promo": { "type": "boolean", "default": false },
        "price": { "$ref": "#/$defs/amount" },
        "promo_price": { "$ref": "#/$defs/amount" },
        "prices": { "$ref": "#/$defs/prices" },
        "combination": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["attribute", "value"],
            "properties": {
              "attribute": { "$ref": "#/$defs/attributeLabel" },
              "value": { "$ref": "#/$defs/attributeLabel" }
            }
          }
        },
        "images": {
          "type": ["array", "null"],
          "description": "Values of images[]._key of the product.",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
