{# Back-office layout of the module pages.

   The module controllers extend BaseAdminController, so their views are rendered by Thelia's
   TwigParser, whose own `app` variable shadows the Symfony one: `app.flashes`, which the theme base
   reads, resolves to nothing, and every message added through addFlash() would be lost. The session
   the parser exposes carries the flash bag, so the messages are read off it instead. #}
{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% set d = 'jsonlinesimporter.bo.default-twig' %}

{% block flash %}
    {% set flashes = app.session is not null ? app.session.flashBag.all : {} %}
    {% for type, messages in flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type }} alert-dismissible fade show" role="alert" data-testid="bo-flash-{{ type }}">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}
{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin_json_lines_importer_list') }}">{{ 'JSONL import'|trans({}, d) }}</a></li>
            {% if import is defined %}
                <li class="breadcrumb-item active" aria-current="page">#{{ import.id }} {{ import.originalName }}</li>
            {% endif %}
        </ol>
    </nav>
{% endblock %}
